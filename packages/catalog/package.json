  "description": "Canonical Velora motion preset registry — generated from CSS and grammar",
  "license": "ISC",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate-catalog.mjs",
    "check": "node scripts/generate-catalog.mjs --check"
