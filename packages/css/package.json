{
  "name": "@velora/css",
  "version": "1.0.0",
  "description": "Declarative CSS motion engine (host-agnostic) with optional Velora theme skin",
  "license": "ISC",
  "unpkg": "./dist/motion-core.css",
  "jsdelivr": "./dist/motion-core.css",
  "main": "./src/velora.css",
  "exports": {
    ".": "./src/velora.css",
    "./base": "./src/base.css",
    "./motion-core": "./src/motion-core.css",
    "./motion-extended": "./src/motion-extended.css",
    "./theme": "./src/theme.css",
    "./components-core": "./src/components-core.css",
    "./transitions": "./src/transitions.css",
    "./premium": "./src/premium.css",
    "./overrides": "./src/overrides.css",
    "./full": "./src/velora.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "homepage": "https://www.veloracss.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/velora-css/velora.git"
  },
  "scripts": {
    "check:dist": "node ./scripts/check-dist.mjs",
    "build": "node ./scripts/build-dist.mjs",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
