{
  "name": "velora",
  "version": "1.0.0",
  "description": "Motion-native CSS framework for premium web interfaces",
  "private": true,
  "license": "ISC",
  "homepage": "https://www.veloracss.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/velora-css/velora.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=showcase",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:all": "turbo run dev",
    "preview": "turbo run preview --filter=showcase",
    "sync:showcase-css": "pnpm --filter showcase sync:framework-css",
    "check:showcase-css": "pnpm --filter showcase check:framework-css-sync",
    "verify:contract": "pnpm sync:showcase-css && pnpm check:showcase-css && pnpm --filter showcase report:vl-contract && pnpm --filter showcase verify:contract"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}
