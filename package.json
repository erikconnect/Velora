{
  "name": "velora",
  "version": "1.0.0",
  "description": "Motion-native CSS framework for premium web interfaces",
  "private": true,
  "license": "ISC",
  "homepage": "https://www.veloracss.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/velora-css/velora.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "pnpm --filter @velora/compiler test && pnpm --filter showcase test:library && pnpm --filter showcase audit:pages:strict && pnpm --filter showcase audit:coverage",
    "dev": "turbo run dev --filter=showcase",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:all": "turbo run dev",
    "preview": "turbo run preview --filter=showcase",
    "report:template": "pnpm --filter showcase report:template",
    "report:motion": "pnpm --filter @velora/compiler scan",
    "check:motion": "pnpm --filter @velora/compiler validate",
    "check:motion:hard": "pnpm --filter @velora/compiler validate:hard",
    "check:motion:migration": "pnpm --filter @velora/compiler validate:migration",
    "generate:motion-css": "pnpm --filter @velora/compiler generate:css -- --root ../../apps/showcase/pages --css-out ../../apps/showcase/public/css/velora.generated.css",
    "migrate:motion": "pnpm --filter @velora/compiler migrate",
    "migrate:motion:dry": "pnpm --filter @velora/compiler migrate:dry",
    "sync:showcase-css": "pnpm --filter showcase sync:framework-css",
    "check:showcase-css": "pnpm --filter showcase check:framework-css-sync",
    "verify:contract": "pnpm sync:showcase-css && pnpm check:showcase-css && pnpm --filter showcase report:vl-contract && pnpm --filter showcase verify:contract && pnpm check:motion"
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "svgo": "4.0.2"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5"
}
