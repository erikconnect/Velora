{
  "name": "velora",
  "version": "1.0.0",
  "private": true,
  "description": "Velora monorepo: motion-native CSS framework, docs, and playground.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=playground",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:all": "turbo run dev --parallel --filter=playground --filter=docs",
    "test": "turbo run build"
  },
  "keywords": [
    "css",
    "design-system",
    "astro",
    "vite",
    "turbo",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "^2.9.5"
  }
}
