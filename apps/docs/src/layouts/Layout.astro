---
import "@velora/css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Velora — Motion-Native Frontend Platform" } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/getting-started", label: "Getting Started" },
  { href: "/components", label: "Components" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
  </head>
  <body>
    <header class="vl-sticky-top vl-frost vl-vt-shared-nav" style="z-index: var(--vl-z-sticky);">
      <nav class="vl-container vl-flex vl-flex--between" style="padding-block: var(--vl-space-sm);">
        <a href="/" class="site-brand vl-vt-shared-brand" style="font-family: var(--vl-font-family-display); font-weight: var(--vl-font-weight-bold); font-size: var(--vl-font-size-lg); text-decoration: none;">
          <span class="vl-text-gradient">Velora</span>
        </a>
        <div class="vl-cluster" style="gap: var(--vl-space-md);">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={["nav-link", { "nav-link--active": currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) }]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <slot />

    <footer style="border-top: 1px solid var(--vl-border-subtle); margin-top: var(--vl-space-3xl);">
      <div class="vl-container vl-flex vl-flex--between vl-flex--wrap" style="padding-block: var(--vl-space-lg); gap: var(--vl-space-md); font-size: var(--vl-font-size-sm); color: var(--vl-text-muted);">
        <span>&copy; {new Date().getFullYear()} Velora. Motion-native CSS framework.</span>
        <div class="vl-cluster" style="gap: var(--vl-space-md);">
          <a href="/" class="nav-link">Home</a>
          <a href="/getting-started" class="nav-link">Getting Started</a>
          <a href="/components" class="nav-link">Components</a>
        </div>
      </div>
    </footer>

    <style>
      .nav-link {
        font-size: var(--vl-font-size-sm);
        font-weight: var(--vl-font-weight-medium);
        color: var(--vl-text-secondary);
        text-decoration: none;
        transition: color var(--vl-duration-fast) var(--vl-ease-out-soft);
      }
      .nav-link:hover {
        color: var(--vl-text-primary);
      }
      .nav-link--active {
        color: var(--vl-color-primary);
      }
    </style>
  </body>
</html>
