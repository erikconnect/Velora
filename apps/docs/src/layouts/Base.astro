---
import "@velora/css";
import "../styles/docs-shell.css";
import { SITE, showcaseUrl } from "../lib/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Velora CSS — declarative motion for modern HTML and CSS" } = Astro.props;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/" || pathname === "";
  return pathname.startsWith(href);
}
---

<!doctype html>
<html
  lang="en"
  data-editorial-theme="noir"
  data-theme="dark"
  data-theme-pack="velora-noir"
  vl-page-transition="cinema"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Velora Docs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/js/docs-state.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="docs-page-shell">
    <a class="vl-sr-only" href="#content">Skip to content</a>

    <header class="vl-header vl-header--glass vl-vt-shared-nav" aria-label="Documentation header">
      <div class="vl-header__inner">
        <a class="vl-header__brand vl-vt-shared-brand" href="/" aria-label="Velora Docs home">
          <img src="/velora-logo.svg" width="120" height="28" alt="Velora" />
        </a>

        <nav class="vl-header__nav" aria-label="Quick links">
          <a class="vl-nav__link" href="/" vl-hover="underline-expand">Docs</a>
          <a class="vl-nav__link" href={`${SITE.showcase}/pages/core/skins.html`} vl-hover="underline-expand">Skins</a>
          <a class="vl-nav__link" href={showcaseUrl("/pages/motion/api-motion-catalog.html")} vl-hover="underline-expand">Catalog</a>
        </nav>

        <div class="vl-header__actions">
          <select class="ds-vt-select" title="Page transition" aria-label="Page transition">
            <option value="cinema">Cinema</option>
            <option value="wipe">Wipe</option>
            <option value="glide">Glide</option>
            <option value="iris">Iris</option>
            <option value="snap">Snap</option>
          </select>
          <select class="ds-editorial-select" title="Editorial skin" aria-label="Editorial skin">
            <option value="noir">Noir</option>
            <option value="earth">Earth tech</option>
            <option value="aethel">Aethel</option>
            <option value="meridian">Meridian</option>
          </select>
          <div class="ds-theme-toggle" role="group" aria-label="Color theme">
            <button class="ds-theme-btn" type="button" data-ds-theme="auto" title="System theme" aria-pressed="false">◑</button>
            <button class="ds-theme-btn" type="button" data-ds-theme="light" title="Light theme" aria-pressed="false">☀</button>
            <button class="ds-theme-btn is-active" type="button" data-ds-theme="dark" title="Dark theme" aria-pressed="true">☾</button>
          </div>
          <a class="docs-header-link" href={SITE.showcase} target="_blank" rel="noopener noreferrer">Showcase</a>
          <a
            class="vl-header-icon-btn"
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Velora on GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12 2C6.477 2 2 6.594 2 12.261c0 4.533 2.865 8.379 6.839 9.736.5.096.682-.222.682-.493 0-.243-.009-.889-.014-1.745-2.782.618-3.37-1.366-3.37-1.366-.455-1.183-1.11-1.498-1.11-1.498-.908-.636.069-.623.069-.623 1.004.072 1.532 1.055 1.532 1.055.892 1.567 2.341 1.114 2.91.852.091-.666.349-1.114.635-1.37-2.221-.258-4.555-1.138-4.555-5.065 0-1.119.389-2.034 1.027-2.751-.103-.26-.445-1.303.097-2.717 0 0 .838-.275 2.747 1.05A9.31 9.31 0 0 1 12 7.317c.85.004 1.706.118 2.505.347 1.908-1.325 2.744-1.05 2.744-1.05.544 1.414.202 2.457.1 2.717.64.717 1.025 1.632 1.025 2.751 0 3.936-2.338 4.804-4.566 5.058.359.317.678.943.678 1.9 0 1.372-.012 2.478-.012 2.815 0 .274.18.594.688.492C19.138 20.637 22 16.792 22 12.261 22 6.594 17.523 2 12 2Z"
              ></path>
            </svg>
          </a>
        </div>

        <button
          class="vl-header__menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="docs-mobile-nav"
          aria-label="Open navigation menu"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
            <rect x="1" y="4" width="16" height="1.8" rx="0.9"></rect>
            <rect x="1" y="8.1" width="16" height="1.8" rx="0.9"></rect>
            <rect x="1" y="12.2" width="16" height="1.8" rx="0.9"></rect>
          </svg>
        </button>
      </div>

      <div class="vl-header__drawer" id="docs-mobile-nav" aria-hidden="true">
        <nav class="vl-header__mobile-nav" aria-label="Mobile documentation navigation">
          <a class="vl-header__mobile-link" href="/">Getting Started</a>
          <a class="vl-header__mobile-link" href="/attributes/">Attributes</a>
          <a class="vl-header__mobile-link" href="/effects/">Effects</a>
          <a class="vl-header__mobile-link" href="/scenes/">Scenes</a>
          <a class="vl-header__mobile-link" href="/compatibility/">Compatibility</a>
        </nav>
        <div class="vl-header__mobile-actions">
          <select class="ds-editorial-select" title="Editorial skin" aria-label="Editorial skin">
            <option value="noir">Noir</option>
            <option value="earth">Earth tech</option>
            <option value="aethel">Aethel</option>
            <option value="meridian">Meridian</option>
          </select>
          <div class="ds-theme-toggle" role="group" aria-label="Color theme">
            <button class="ds-theme-btn" type="button" data-ds-theme="auto" aria-pressed="false">◑</button>
            <button class="ds-theme-btn" type="button" data-ds-theme="light" aria-pressed="false">☀</button>
            <button class="ds-theme-btn is-active" type="button" data-ds-theme="dark" aria-pressed="true">☾</button>
          </div>
          <a class="docs-header-link" href={SITE.showcase} target="_blank" rel="noopener noreferrer">Showcase</a>
        </div>
      </div>
    </header>

    <div class="docs-layout">
      <aside class="docs-sidebar vl-card vl-card--glass" aria-label="Documentation sidebar">
        <nav aria-label="Documentation navigation">
          <p class="docs-nav-section">Core</p>
          <a href="/" aria-current={isActive("/") ? "page" : undefined}>Getting Started</a>
          <a href="/attributes/" aria-current={isActive("/attributes") ? "page" : undefined}>Attributes</a>
          <a href="/effects/" aria-current={isActive("/effects") ? "page" : undefined}>Effects</a>
          <a href="/timelines/" aria-current={isActive("/timelines") ? "page" : undefined}>Timelines</a>
          <a href="/scenes/" aria-current={isActive("/scenes") ? "page" : undefined}>Scenes</a>
          <a href="/hosts/" aria-current={isActive("/hosts") ? "page" : undefined}>Hosts</a>
          <a href="/compatibility/" aria-current={isActive("/compatibility") ? "page" : undefined}>Compatibility</a>
          <a href="/motion-conditions/" aria-current={isActive("/motion-conditions") ? "page" : undefined}>Conditional Motion</a>
          <a href="/transitions/" aria-current={isActive("/transitions") ? "page" : undefined}>Transitions</a>
          <a href="/tokens/" aria-current={isActive("/tokens") ? "page" : undefined}>Tokens</a>
          <p class="docs-nav-section">Showcase</p>
          <a href={showcaseUrl("/pages/motion/api-motion-catalog.html")} target="_blank" rel="noopener noreferrer">Motion catalog</a>
          <a href={showcaseUrl("/pages/motion/playground.html")} target="_blank" rel="noopener noreferrer">Playground</a>
          <a href={showcaseUrl("/pages/core/skins.html")} target="_blank" rel="noopener noreferrer">Skins reference</a>
          <p class="docs-nav-section">For Agents</p>
          <a href="/skills/" aria-current={isActive("/skills") ? "page" : undefined}>Skill Sets</a>
          <a href="/agents/" aria-current={isActive("/agents") ? "page" : undefined}>Agent Handbook</a>
        </nav>
      </aside>

      <main id="content" class="docs-main">
        <slot />
      </main>
    </div>

    <script is:inline src="/js/docs-ui.js"></script>
    <script is:inline src="/js/docs-live.js"></script>
  </body>
</html>
