---
import Base from "../layouts/Base.astro";
import DocsLive from "../components/DocsLive.astro";
---

<Base title="Hosts" description="Use Velora motion-core with Tailwind, WordPress, or any UI — no Velora skin required.">
  <span class="vl-kicker">Interoperability</span>

  <h1 class="docs-page-title">Hosts (Tailwind, WordPress &amp; others)</h1>
  <p class="docs-page-lead">
    Velora is a motion engine. Your host owns layout and visual styling — motion attributes still work.
  </p>

  <DocsLive
    scroll="short"
    code={'class="…tailwind…" vl-enter="clip-rise" vl-timeline="view"'}
  >
    <div
      style="inline-size:100%;max-width:28rem;padding:1.5rem;border-radius:0.75rem;border:1px solid var(--vl-border-subtle);display:grid;gap:0.75rem;"
    >
      <p style="font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--vl-text-muted);" vl-enter="fade-up" vl-timeline="view">
        Host utility classes
      </p>
      <h3 class="docs-live__demo-title" vl-enter="clip-rise" vl-timeline="view">No .vl-card required</h3>
      <p class="docs-live__demo-copy" vl-enter="fade-up" vl-timeline="view" vl-delay="80ms">
        Only <code>vl-*</code> attributes drive motion
      </p>
    </div>
  </DocsLive>

  <h2>Minimal import</h2>
  <pre><code>@import "@velora/css/motion-core";
@import "@velora/css/transitions"; /* optional */</code></pre>

  <h2>WordPress</h2>
  <p>
    Same attributes in PHP templates, Gutenberg, or Elementor —
    <a href="https://github.com/erikconnect/Velora/tree/main/examples/wordpress">examples/wordpress/</a>.
  </p>
</Base>
