---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Velora — Documentação">
  <main class="vl-container vl-section">
    <div class="vl-stack vl-stack--lg" style="max-width: 42rem; margin-inline: auto; text-align: center">
      <h1 class="vl-text-gradient" style="font-size: clamp(2rem, 5vw, 3rem)">Velora</h1>
      <p style="color: var(--vl-text-secondary)">
        Documentação oficial (Astro + HTML estático). O pacote <code>@velora/css</code> é importado no layout — tokens
        <code>oklch</code>, <code>@layer</code> e componentes <code>.vl-*</code>.
      </p>
      <div class="vl-card vl-motion-fade-up" style="text-align: left">
        <div class="vl-card__title">Começar</div>
        <p class="vl-card__body">
          Use o playground em <code>apps/playground</code> para demos interativas, incluindo View Transitions entre
          páginas.
        </p>
      </div>
    </div>
  </main>
</Layout>
