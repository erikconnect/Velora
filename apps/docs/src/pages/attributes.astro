---
import Base from "../layouts/Base.astro";
import DocsLive from "../components/DocsLive.astro";
---

<Base title="Attribute Reference" description="Velora motion attribute grammar — channels v2, scene engine and timing controls.">
  <span class="vl-kicker">Reference</span>

  <h1 class="docs-page-title">Attribute Reference</h1>
  <p class="docs-page-lead">
    Velora motion is declared with <code>vl-*</code> HTML attributes. Prefer <strong>channels</strong>
    for new work. Each section includes a live frame — <strong>Test here</strong>.
  </p>

  <h2>Channels (preferred)</h2>
  <DocsLive
    scroll="short"
    code={'vl-enter="fade-up" · vl-hover="hover-lift"'}
  >
    <div class="docs-live__row">
      <article class="vl-card" vl-enter="fade-up" vl-timeline="view">
        <h3 class="vl-card__title">vl-enter</h3>
        <p class="vl-card__body">fade-up on view</p>
      </article>
      <article class="vl-card" vl-hover="hover-lift">
        <h3 class="vl-card__title">vl-hover</h3>
        <p class="vl-card__body">Hover this card</p>
      </article>
    </div>
  </DocsLive>

  <h2>vl-in-view gate</h2>
  <p>
    Temporal gate — descendant motion replays when the gate re-enters the scrollport.
    Requires <code>container-type: style</code> (Chrome 128+, Safari 18+); otherwise
    <code>vl-in-view</code> is inert and children animate on their own timelines.
  </p>
  <DocsLive scroll="short" code={'<div vl-in-view><p vl-enter="blur-in" vl-timeline="view">…</p></div>'}>
    <div vl-in-view>
      <p class="docs-live__demo-title" vl-enter="blur-in" vl-timeline="view">Replay on re-entry</p>
      <p class="docs-live__demo-copy" vl-enter="fade-up" vl-timeline="view" vl-delay="100ms">
        Scroll away, scroll back, or press Replay
      </p>
    </div>
  </DocsLive>

  <h2>Quick Reference</h2>
  <table>
    <thead>
      <tr><th>Attribute</th><th>Type</th><th>Brief</th></tr>
    </thead>
    <tbody>
      <tr><td><code>vl-enter</code></td><td>tokens</td><td>Entrance preset (preferred)</td></tr>
      <tr><td><code>vl-exit</code></td><td>tokens</td><td>Exit preset</td></tr>
      <tr><td><code>vl-scroll</code></td><td>tokens</td><td>Scroll-linked motion</td></tr>
      <tr><td><code>vl-hover</code></td><td>tokens</td><td>Hover / focus interaction</td></tr>
      <tr><td><code>vl-effect</code></td><td>tokens</td><td>Legacy / composite escape hatch</td></tr>
      <tr><td><code>vl-timeline</code></td><td>enum</td><td>view, scroll, auto, hover, state</td></tr>
      <tr><td><code>vl-in-view</code></td><td>boolean</td><td>Viewport gate for descendant motion</td></tr>
      <tr><td><code>vl-scene</code> / <code>vl-stage</code></td><td>track + stage</td><td>Scene engine</td></tr>
      <tr><td><code>vl-act</code> / <code>vl-span</code></td><td>number</td><td>Scene beat index and span</td></tr>
      <tr><td><code>vl-pin</code> / <code>vl-scrub</code></td><td>number / boolean</td><td>Pin+scrub track</td></tr>
      <tr><td><code>vl-motion</code></td><td>enum</td><td>Subtree motion mode</td></tr>
      <tr><td><code>vl-page-transition</code></td><td>enum</td><td>MPA transition on <code>&lt;html&gt;</code></td></tr>
    </tbody>
  </table>

  <h2>Scene engine</h2>
  <DocsLive scroll="scene" code={'vl-scene + vl-stage + vl-act'}>
    <section class="docs-live__scene-track" vl-scene vl-timeline="view" vl-pin="2" vl-scrub>
      <div vl-stage>
        <h3 class="docs-live__demo-title" vl-enter="clip-rise" vl-act="1">Title act</h3>
        <p class="docs-live__demo-copy" vl-scroll="parallax" vl-act="2" vl-span="2">Scroll-linked child</p>
      </div>
    </section>
  </DocsLive>

  <h2>Further reading</h2>
  <ul>
    <li><a href="/effects/" class="docs-link-primary">Effects</a></li>
    <li><a href="/scenes/" class="docs-link-primary">Scenes</a></li>
    <li><a href="/timelines/" class="docs-link-primary">Timelines</a></li>
    <li><a href="/compatibility/" class="docs-link-primary">Compatibility</a></li>
  </ul>
</Base>
