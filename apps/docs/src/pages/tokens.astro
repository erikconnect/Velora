  <pre><code>&lt;link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500
  &amp;family=Outfit:wght@400;500;600;700
  &amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap"
  rel="stylesheet" /&gt;</code></pre>
