---
import Base from "../layouts/Base.astro";
import DocsLive from "../components/DocsLive.astro";
---

<Base title="Timelines" description="vl-timeline view vs auto, ranges, scrub, and the scene clock.">
  <span class="vl-kicker">Progress model</span>

  <h1 class="docs-page-title">Timelines</h1>
  <p class="docs-page-lead">
    Timelines decide <em>what drives progress</em>. Channels decide <em>what moves</em>.
    Test each model in the frames below.
  </p>

  <h2>vl-timeline="view"</h2>
  <DocsLive scroll="short" code={'vl-enter="fade-up" vl-timeline="view"'}>
    <p class="docs-live__demo-title" vl-enter="fade-up" vl-timeline="view">View progress</p>
    <p class="docs-live__demo-copy" vl-enter="fade-up" vl-timeline="view" vl-delay="90ms">
      Linked to visibility in the scrollport
    </p>
  </DocsLive>

  <h2>vl-timeline="auto"</h2>
  <DocsLive scroll="none" hint="Plays on load — refresh or navigate to replay." code={'vl-enter="scale-in" vl-timeline="auto"'}>
    <p class="docs-live__demo-title" vl-enter="scale-in" vl-timeline="auto">Auto timeline</p>
    <p class="docs-live__demo-copy" vl-enter="fade-up" vl-timeline="auto" vl-delay="120ms">Time-based, no scroll needed</p>
  </DocsLive>

  <h2>vl-timeline="hover"</h2>
  <DocsLive scroll="none" hint="Hover or focus the card." code={'vl-timeline="hover"'}>
    <article class="vl-card" vl-enter="fade-up" vl-timeline="hover" tabindex="0">
      <h3 class="vl-card__title">Hover to play</h3>
      <p class="vl-card__body">Progress gated by intent</p>
    </article>
  </DocsLive>

  <h2>Scene clock + scrub</h2>
  <DocsLive scroll="scene" code={'vl-scene vl-timeline="view" vl-pin="2" vl-scrub'}>
    <section class="docs-live__scene-track" vl-scene vl-timeline="view" vl-pin="2" vl-scrub>
      <div vl-stage>
        <p class="docs-live__demo-chip" vl-enter="fade-up" vl-act="1">Shared clock</p>
        <h3 class="docs-live__demo-title" vl-enter="clip-rise" vl-act="2">Scrub acts</h3>
      </div>
    </section>
  </DocsLive>

  <h2>Reference</h2>
  <table>
    <thead>
      <tr><th>Value</th><th>Behavior</th></tr>
    </thead>
    <tbody>
      <tr><td><code>view</code></td><td>Element / scene visibility (<code>view()</code> or <code>--vl-scene</code>)</td></tr>
      <tr><td><code>scroll</code></td><td>Root scroll progress</td></tr>
      <tr><td><code>auto</code></td><td>Time-based CSS animation</td></tr>
      <tr><td><code>hover</code></td><td>Paused until hover / focus</td></tr>
    </tbody>
  </table>
</Base>
